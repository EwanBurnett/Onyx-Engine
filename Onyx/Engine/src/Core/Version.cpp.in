#include "Onyx/Core/Version.h"
#include <cstdio>

namespace Onyx{
    const int ONYX_GIT_HASH = 0x@GIT_HASH@;
    const int ONYX_VERSION_MAJOR = @ONYX_VERSION_MAJOR@;
    const int ONYX_VERSION_MINOR = @ONYX_VERSION_MINOR@;
    const int ONYX_VERSION_ISSUE = @ONYX_VERSION_ISSUE@;

    const char* ONYX_GIT_BRANCH = "@GIT_BRANCH_NAME@";
}

std::string Onyx::GetVersionString(){
    char buffer[0xff]; 
#if ONYX_PLATFORM_WINDOWS
    sprintf_s(buffer, 0xff, "v%d.%d.%d Hash[0x%x]", ONYX_VERSION_MAJOR, ONYX_VERSION_MINOR, ONYX_VERSION_ISSUE, ONYX_GIT_HASH); 
#else
    sprintf(buffer, "v%d.%d.%d Hash[0x%x]", ONYX_VERSION_MAJOR, ONYX_VERSION_MINOR, ONYX_VERSION_ISSUE, ONYX_GIT_HASH);
#endif

    return buffer; 
}

std::string Onyx::GetBranchName(){ 
    return ONYX_GIT_BRANCH; 
}
